pub fn ckToInfo(st: CkState) -> Info {
    let CkMaps(types, uses, defs, params, funcs, lits, datas, cpats, pvars, targs, syms, mainId, mainIO, fmods) = mapsOf(st)
    let TyEnv(dinfos, _, _) = envOf(st)
    Info(types, uses, defs, params, funcs, lits, datas, cpats, pvars, targs, syms, dinfos, mainId, mainIO, fmods)
}
