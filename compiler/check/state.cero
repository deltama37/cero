import "std/list"
import "std/option"
import "std/pair"
import "syntax/diag"
import "types/types"
import "util/intmap"
import "util/strmap"
import "check/unify"

pub type SymKind =
    | CkSymFunc
    | CkSymParam
    | CkSymLocal
    | CkSymCtor
    | CkSymBuiltin

pub type Symbol =
    | Symbol(SymKind, String, Type, Pos, Int, Option[Pair[Int, Int]], List[Type], Int)

pub type Info =
    | Info(IntMap[Type], IntMap[Int], IntMap[Int], IntMap[Int], IntMap[Int], IntMap[Type], IntMap[Int], IntMap[Pair[Int, Int]], IntMap[Int], IntMap[List[Type]], IntMap[Symbol], IntMap[DataInfo], Int, Bool, IntMap[Int])

pub type CkPending =
    | CkPending(Int, Pos, String, Int)

pub type CkCompRef =
    | CkCompRef(Int, Int, Int, Pos)

pub type CkImport =
    | CkImport(Int, String)

pub type CkMaps =
    | CkMaps(IntMap[Type], IntMap[Int], IntMap[Int], IntMap[Int], IntMap[Int], IntMap[Type], IntMap[Int], IntMap[Pair[Int, Int]], IntMap[Int], IntMap[List[Type]], IntMap[Symbol], Int, Bool, IntMap[Int])

pub type CkLocal =
    | CkLocal(StrMap[Int], StrMap[Int], StrMap[Int], StrMap[CkImport], StrMap[CkImport], Bool, StrMap[Type], List[CkPending], Int, IntMap[Bool], List[CkCompRef], IntMap[Bool], Int)

pub type CkState =
    | CkState(CkMaps, CkLocal, TyEnv, Int)

pub type CkScope =
    | CkScope(StrMap[Int])

pub type CkCtx =
    | CkCtx(Option[CkCtx], List[CkScope])

pub type CkResult[A] =
    | CkOk(A, CkState)
    | CkErr(Error)

pub type Check[A] =
    | Check(CkState -> CkResult[A])

pub fn bind[A, B](m: Check[A], f: A -> Check[B]) -> Check[B] {
    Check(fn(s: CkState) -> CkResult[B] {
        match m {
            Check(run) => match run(s) {
                CkErr(e) => CkErr(e),
                CkOk(x, s2) => match f(x) {
                    Check(run2) => run2(s2),
                },
            },
        }
    })
}

pub fn pure[A](x: A) -> Check[A] {
    Check(fn(s: CkState) -> CkResult[A] { CkOk(x, s) })
}

pub fn ckFail[A](e: Error) -> Check[A] {
    Check(fn(_: CkState) -> CkResult[A] { CkErr(e) })
}

pub fn ckRun[A](m: Check[A], s: CkState) -> CkResult[A] {
    let Check(f) = m
    f(s)
}

pub fn ckGet() -> Check[CkState] {
    Check(fn(s: CkState) -> CkResult[CkState] { CkOk(s, s) })
}

pub fn ckModify(f: CkState -> CkState) -> Check[Unit] {
    Check(fn(s: CkState) -> CkResult[Unit] { CkOk((), f(s)) })
}

fn mapsEmpty() -> CkMaps {
    CkMaps(imEmpty(), imEmpty(), imEmpty(), imEmpty(), imEmpty(), imEmpty(), imEmpty(), imEmpty(), imEmpty(), imEmpty(), imEmpty(), -1, false, imEmpty())
}

fn localEmpty(isEntry: Bool) -> CkLocal {
    CkLocal(smEmpty(), smEmpty(), smEmpty(), smEmpty(), smEmpty(), isEntry, smEmpty(), Nil, 0, imEmpty(), Nil, imEmpty(), -1)
}

fn envInitial() -> TyEnv {
    let io = DataInfo("IO", Cons(TyParam(0, "T"), Nil), Nil)
    TyEnv(imInsert(imEmpty(), 0, io), imEmpty(), imEmpty())
}

pub fn ckInitial() -> CkState {
    CkState(mapsEmpty(), localEmpty(false), envInitial(), 1)
}

pub fn ckEmptyCtx() -> CkCtx {
    CkCtx(None, Nil)
}

fn envOf(st: CkState) -> TyEnv {
    let CkState(_, _, env, _) = st
    env
}

fn mapsOf(st: CkState) -> CkMaps {
    let CkState(maps, _, _, _) = st
    maps
}

fn localOf(st: CkState) -> CkLocal {
    let CkState(_, local, _, _) = st
    local
}

fn withEnv(st: CkState, env: TyEnv) -> CkState {
    let CkState(maps, local, _, next) = st
    CkState(maps, local, env, next)
}

fn withMaps(st: CkState, maps: CkMaps) -> CkState {
    let CkState(_, local, env, next) = st
    CkState(maps, local, env, next)
}

fn withLocal(st: CkState, local: CkLocal) -> CkState {
    let CkState(maps, _, env, next) = st
    CkState(maps, local, env, next)
}

fn withNext(st: CkState, next: Int) -> CkState {
    let CkState(maps, local, env, _) = st
    CkState(maps, local, env, next)
}

pub fn ckEnv() -> Check[TyEnv] {
    let! st = ckGet()
    pure(envOf(st))
}

pub fn ckSetEnv(env: TyEnv) -> Check[Unit] {
    ckModify(fn(st: CkState) -> CkState { withEnv(st, env) })
}

pub fn ckAlloc() -> Check[Int] {
    Check(fn(st: CkState) -> CkResult[Int] {
        let CkState(_, _, _, next) = st
        CkOk(next, withNext(st, next + 1))
    })
}

pub fn ckAllocTyParam(name: String) -> Check[Type] {
    let! id = ckAlloc()
    pure(TyParam(id, name))
}

fn symsOf(maps: CkMaps) -> IntMap[Symbol] {
    let CkMaps(_, _, _, _, _, _, _, _, _, _, syms, _, _, _) = maps
    syms
}

fn putSymMap(maps: CkMaps, id: Int, sym: Symbol) -> CkMaps {
    let CkMaps(types, uses, defs, params, funcs, lits, datas, cpats, pvars, targs, _, mainId, mainIO, fmods) = maps
    CkMaps(types, uses, defs, params, funcs, lits, datas, cpats, pvars, targs, imInsert(symsOf(maps), id, sym), mainId, mainIO, fmods)
}

pub fn ckSym(st: CkState, id: Int) -> Symbol {
    withDefault(imLookup(symsOf(mapsOf(st)), id), Symbol(CkSymBuiltin, "", TyUnit, Pos(0, 0), -1, None, Nil, -1))
}

pub fn ckPutSym(id: Int, sym: Symbol) -> Check[Unit] {
    ckModify(fn(st: CkState) -> CkState { withMaps(st, putSymMap(mapsOf(st), id, sym)) })
}

pub fn ckNewSym(kind: SymKind, name: String, typ: Type, pos: Pos, decl: Int, ctor: Option[Pair[Int, Int]], tps: List[Type], bno: Int) -> Check[Int] {
    let! id = ckAlloc()
    let! _ = ckPutSym(id, Symbol(kind, name, typ, pos, decl, ctor, tps, bno))
    pure(id)
}

pub fn ckSetSymType(id: Int, typ: Type, tps: List[Type]) -> Check[Unit] {
    let! st = ckGet()
    let Symbol(k, name, _, pos, decl, ctor, _, bno) = ckSym(st, id)
    ckPutSym(id, Symbol(k, name, typ, pos, decl, ctor, tps, bno))
}

fn putTypes(maps: CkMaps, id: Int, t: Type) -> CkMaps {
    let CkMaps(types, uses, defs, params, funcs, lits, datas, cpats, pvars, targs, syms, mainId, mainIO, fmods) = maps
    CkMaps(imInsert(types, id, t), uses, defs, params, funcs, lits, datas, cpats, pvars, targs, syms, mainId, mainIO, fmods)
}

fn putUses(maps: CkMaps, id: Int, sym: Int) -> CkMaps {
    let CkMaps(types, uses, defs, params, funcs, lits, datas, cpats, pvars, targs, syms, mainId, mainIO, fmods) = maps
    CkMaps(types, imInsert(uses, id, sym), defs, params, funcs, lits, datas, cpats, pvars, targs, syms, mainId, mainIO, fmods)
}

fn putDefs(maps: CkMaps, id: Int, sym: Int) -> CkMaps {
    let CkMaps(types, uses, defs, params, funcs, lits, datas, cpats, pvars, targs, syms, mainId, mainIO, fmods) = maps
    CkMaps(types, uses, imInsert(defs, id, sym), params, funcs, lits, datas, cpats, pvars, targs, syms, mainId, mainIO, fmods)
}

fn putParams(maps: CkMaps, id: Int, sym: Int) -> CkMaps {
    let CkMaps(types, uses, defs, params, funcs, lits, datas, cpats, pvars, targs, syms, mainId, mainIO, fmods) = maps
    CkMaps(types, uses, defs, imInsert(params, id, sym), funcs, lits, datas, cpats, pvars, targs, syms, mainId, mainIO, fmods)
}

fn putFuncs(maps: CkMaps, id: Int, sym: Int) -> CkMaps {
    let CkMaps(types, uses, defs, params, funcs, lits, datas, cpats, pvars, targs, syms, mainId, mainIO, fmods) = maps
    CkMaps(types, uses, defs, params, imInsert(funcs, id, sym), lits, datas, cpats, pvars, targs, syms, mainId, mainIO, fmods)
}

fn putLits(maps: CkMaps, id: Int, t: Type) -> CkMaps {
    let CkMaps(types, uses, defs, params, funcs, lits, datas, cpats, pvars, targs, syms, mainId, mainIO, fmods) = maps
    CkMaps(types, uses, defs, params, funcs, imInsert(lits, id, t), datas, cpats, pvars, targs, syms, mainId, mainIO, fmods)
}

fn putDatas(maps: CkMaps, id: Int, data: Int) -> CkMaps {
    let CkMaps(types, uses, defs, params, funcs, lits, datas, cpats, pvars, targs, syms, mainId, mainIO, fmods) = maps
    CkMaps(types, uses, defs, params, funcs, lits, imInsert(datas, id, data), cpats, pvars, targs, syms, mainId, mainIO, fmods)
}

fn putCpats(maps: CkMaps, id: Int, pair: Pair[Int, Int]) -> CkMaps {
    let CkMaps(types, uses, defs, params, funcs, lits, datas, cpats, pvars, targs, syms, mainId, mainIO, fmods) = maps
    CkMaps(types, uses, defs, params, funcs, lits, datas, imInsert(cpats, id, pair), pvars, targs, syms, mainId, mainIO, fmods)
}

fn putPvars(maps: CkMaps, id: Int, sym: Int) -> CkMaps {
    let CkMaps(types, uses, defs, params, funcs, lits, datas, cpats, pvars, targs, syms, mainId, mainIO, fmods) = maps
    CkMaps(types, uses, defs, params, funcs, lits, datas, cpats, imInsert(pvars, id, sym), targs, syms, mainId, mainIO, fmods)
}

fn putTargs(maps: CkMaps, id: Int, args: List[Type]) -> CkMaps {
    let CkMaps(types, uses, defs, params, funcs, lits, datas, cpats, pvars, targs, syms, mainId, mainIO, fmods) = maps
    CkMaps(types, uses, defs, params, funcs, lits, datas, cpats, pvars, imInsert(targs, id, args), syms, mainId, mainIO, fmods)
}

fn putFmod(maps: CkMaps, id: Int, modIdx: Int) -> CkMaps {
    let CkMaps(types, uses, defs, params, funcs, lits, datas, cpats, pvars, targs, syms, mainId, mainIO, fmods) = maps
    CkMaps(types, uses, defs, params, funcs, lits, datas, cpats, pvars, targs, syms, mainId, mainIO, imInsert(fmods, id, modIdx))
}

fn putMain(maps: CkMaps, sym: Int, io: Bool) -> CkMaps {
    let CkMaps(types, uses, defs, params, funcs, lits, datas, cpats, pvars, targs, syms, _, _, fmods) = maps
    CkMaps(types, uses, defs, params, funcs, lits, datas, cpats, pvars, targs, syms, sym, io, fmods)
}

pub fn ckSetType(id: Int, t: Type) -> Check[Unit] {
    ckModify(fn(st: CkState) -> CkState { withMaps(st, putTypes(mapsOf(st), id, t)) })
}

