import "std/list"

fn hexDigit(n: Int) -> String {
    if n < 10 {
        stringFromByte('0' + n)
    } else {
        stringFromByte('a' + n - 10)
    }
}

fn hexByte(b: Int) -> String {
    "\\x" ++ hexDigit(b / 16) ++ hexDigit(b % 16)
}

fn asciiEscape(b: Int) -> String {
    if b == 7 {
        "\\a"
    } else if b == 8 {
        "\\b"
    } else if b == 12 {
        "\\f"
    } else if b == 10 {
        "\\n"
    } else if b == 13 {
        "\\r"
    } else if b == 9 {
        "\\t"
    } else if b == 11 {
        "\\v"
    } else {
        hexByte(b)
    }
}

fn pairUp(xs: List[String], acc: List[String]) -> List[String] {
    match xs {
        Nil => reverse(acc),
        Cons(x, Nil) => reverse(Cons(x, acc)),
        Cons(x, Cons(y, rest)) => pairUp(rest, Cons(x ++ y, acc)),
    }
}

pub fn concatBalanced(xs: List[String]) -> String {
    match xs {
        Nil => "",
        Cons(x, Nil) => x,
        _ => concatBalanced(pairUp(xs, Nil)),
    }
}

fn cont(s: String, i: Int, n: Int) -> Bool {
    if i >= n {
        false
    } else {
        let b = stringByteAt(s, i)
        b >= 128 && b <= 191
    }
}

fn runeLen(s: String, i: Int) -> Int {
    let n = stringLength(s)
    if i >= n {
        0
    } else {
        let b = stringByteAt(s, i)
        if b < 128 {
            1
        } else if b < 194 || b > 244 {
            0
        } else if b < 224 {
            if cont(s, i + 1, n) {
                2
            } else {
                0
            }
        } else if b < 240 {
            if i + 2 >= n {
                0
            } else {
                let b2 = stringByteAt(s, i + 1)
                let ok2 = if b == 224 {
                    b2 >= 160 && b2 <= 191
                } else if b == 237 {
                    b2 >= 128 && b2 <= 159
                } else {
                    b2 >= 128 && b2 <= 191
                }
                if ok2 && cont(s, i + 2, n) {
                    3
                } else {
                    0
                }
            }
        } else {
            if i + 3 >= n {
                0
            } else {
                let b2 = stringByteAt(s, i + 1)
                let ok2 = if b == 240 {
                    b2 >= 144 && b2 <= 191
                } else if b == 244 {
                    b2 >= 128 && b2 <= 143
                } else {
                    b2 >= 128 && b2 <= 191
                }
                if ok2 && cont(s, i + 2, n) && cont(s, i + 3, n) {
                    4
                } else {
                    0
                }
            }
        }
    }
}

fn plainEnd(s: String, i: Int, q: Int) -> Int {
    let n = stringLength(s)
    if i >= n {
        i
    } else {
        let b = stringByteAt(s, i)
        if b >= 32 && b < 127 && b != q && b != '\\' {
            plainEnd(s, i + 1, q)
        } else {
            i
        }
    }
}

fn quoteAcc(s: String, i: Int, q: Int, acc: List[String]) -> List[String] {
    let n = stringLength(s)
    if i >= n {
        acc
    } else {
        let b = stringByteAt(s, i)
        if b < 128 {
            if b == q || b == '\\' {
                quoteAcc(s, i + 1, q, Cons("\\" ++ stringFromByte(b), acc))
            } else if b >= 32 && b < 127 {
                let j = plainEnd(s, i, q)
                quoteAcc(s, j, q, Cons(stringSlice(s, i, j), acc))
            } else {
                quoteAcc(s, i + 1, q, Cons(asciiEscape(b), acc))
            }
        } else {
            let w = runeLen(s, i)
            if w >= 2 {
                quoteAcc(s, i + w, q, Cons(stringSlice(s, i, i + w), acc))
            } else {
                quoteAcc(s, i + 1, q, Cons(hexByte(b), acc))
            }
        }
    }
}

fn wrapQuote(s: String, q: Int) -> String {
    let body = reverse(quoteAcc(s, 0, q, Nil))
    concatBalanced(Cons(stringFromByte(q), append(body, Cons(stringFromByte(q), Nil))))
}

pub fn quoteString(s: String) -> String {
    wrapQuote(s, '"')
}

pub fn quoteRune(s: String) -> String {
    wrapQuote(s, '\'')
}
