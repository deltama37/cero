import "lower/state"
import "lower/captures"

type LwResult[A] =
    | LwOk(A, LwState)

type Lower[A] =
    | Lower(LwState -> LwResult[A])

fn bind[A, B](m: Lower[A], f: A -> Lower[B]) -> Lower[B] {
    Lower(fn(s: LwState) -> LwResult[B] {
        match m {
            Lower(run) => match run(s) {
                LwOk(x, s2) => match f(x) {
                    Lower(run2) => run2(s2),
                },
            },
        }
    })
}

fn pure[A](x: A) -> Lower[A] {
    Lower(fn(s: LwState) -> LwResult[A] { LwOk(x, s) })
}

fn lwGet() -> Lower[LwState] {
    Lower(fn(s: LwState) -> LwResult[LwState] { LwOk(s, s) })
}

fn lwModify(f: LwState -> LwState) -> Lower[Unit] {
    Lower(fn(s: LwState) -> LwResult[Unit] { LwOk((), f(s)) })
}

fn infoOf(s: LwState) -> Info {
    let LwState(info, _, _, _, _, _, _, _) = s
    info
}

fn modsOf(s: LwState) -> List[Module] {
    let LwState(_, mods, _, _, _, _, _, _) = s
    mods
}

fn entryOf(s: LwState) -> IntMap[Bool] {
    let LwState(_, _, entry, _, _, _, _, _) = s
    entry
}

fn declsOf(s: LwState) -> IntMap[FuncDecl] {
    let LwState(_, _, _, decls, _, _, _, _) = s
    decls
}

fn polysOf(s: LwState) -> IntMap[LetStmt] {
    let LwState(_, _, _, _, polys, _, _, _) = s
    polys
}

fn genOf(s: LwState) -> LwGen {
    let LwState(_, _, _, _, _, g, _, _) = s
    g
}

fn modOf(s: LwState) -> LwMod {
    let LwState(_, _, _, _, _, _, m, _) = s
    m
}

fn curOf(s: LwState) -> LwCur {
    let LwState(_, _, _, _, _, _, _, c) = s
    c
}

fn setGen(s: LwState, g: LwGen) -> LwState {
    let LwState(info, mods, entry, decls, polys, _, md, cur) = s
    LwState(info, mods, entry, decls, polys, g, md, cur)
}

fn setMod(s: LwState, m: LwMod) -> LwState {
    let LwState(info, mods, entry, decls, polys, g, _, cur) = s
    LwState(info, mods, entry, decls, polys, g, m, cur)
}

fn setCur(s: LwState, c: LwCur) -> LwState {
    let LwState(info, mods, entry, decls, polys, g, md, _) = s
    LwState(info, mods, entry, decls, polys, g, md, c)
}

fn gDecls(g: LwGen) -> IntMap[Int] {
    let LwGen(a, _, _, _, _, _, _, _, _, _) = g
    a
}

fn gInsts(g: LwGen) -> StrMap[Int] {
    let LwGen(_, a, _, _, _, _, _, _, _, _) = g
    a
}

fn gQueue(g: LwGen) -> LwQ {
    let LwGen(_, _, a, _, _, _, _, _, _, _) = g
    a
}

fn gEnv(g: LwGen) -> IntMap[ValType] {
    let LwGen(_, _, _, a, _, _, _, _, _, _) = g
    a
}

fn gLambdas(g: LwGen) -> Int {
    let LwGen(_, _, _, _, a, _, _, _, _, _) = g
    a
}

fn gMemo(g: LwGen) -> IntMap[List[Int]] {
    let LwGen(_, _, _, _, _, a, _, _, _, _) = g
    a
}

fn gRefs(g: LwGen) -> IntMap[Int] {
    let LwGen(_, _, _, _, _, _, a, _, _, _) = g
    a
}

fn gBRefs(g: LwGen) -> IntMap[Int] {
    let LwGen(_, _, _, _, _, _, _, a, _, _) = g
    a
}

fn gActs(g: LwGen) -> StrMap[Int] {
    let LwGen(_, _, _, _, _, _, _, _, a, _) = g
    a
}

fn gIORefs(g: LwGen) -> StrMap[Int] {
    let LwGen(_, _, _, _, _, _, _, _, _, a) = g
    a
}

fn gWithDecls(g: LwGen, a: IntMap[Int]) -> LwGen {
    let LwGen(_, b, c, d, e, f, h, i, j, k) = g
    LwGen(a, b, c, d, e, f, h, i, j, k)
}

fn gWithInsts(g: LwGen, b: StrMap[Int]) -> LwGen {
    let LwGen(a, _, c, d, e, f, h, i, j, k) = g
    LwGen(a, b, c, d, e, f, h, i, j, k)
}

fn gWithQueue(g: LwGen, c: LwQ) -> LwGen {
    let LwGen(a, b, _, d, e, f, h, i, j, k) = g
    LwGen(a, b, c, d, e, f, h, i, j, k)
}

fn gWithEnv(g: LwGen, d: IntMap[ValType]) -> LwGen {
    let LwGen(a, b, c, _, e, f, h, i, j, k) = g
    LwGen(a, b, c, d, e, f, h, i, j, k)
}

fn gWithLambdas(g: LwGen, e: Int) -> LwGen {
    let LwGen(a, b, c, d, _, f, h, i, j, k) = g
    LwGen(a, b, c, d, e, f, h, i, j, k)
}

fn gWithMemo(g: LwGen, f: IntMap[List[Int]]) -> LwGen {
    let LwGen(a, b, c, d, e, _, h, i, j, k) = g
    LwGen(a, b, c, d, e, f, h, i, j, k)
}

fn gWithRefs(g: LwGen, h: IntMap[Int]) -> LwGen {
    let LwGen(a, b, c, d, e, f, _, i, j, k) = g
    LwGen(a, b, c, d, e, f, h, i, j, k)
}

fn gWithBRefs(g: LwGen, i: IntMap[Int]) -> LwGen {
    let LwGen(a, b, c, d, e, f, h, _, j, k) = g
    LwGen(a, b, c, d, e, f, h, i, j, k)
}

fn gWithActs(g: LwGen, j: StrMap[Int]) -> LwGen {
    let LwGen(a, b, c, d, e, f, h, i, _, k) = g
    LwGen(a, b, c, d, e, f, h, i, j, k)
}

fn gWithIORefs(g: LwGen, k: StrMap[Int]) -> LwGen {
    let LwGen(a, b, c, d, e, f, h, i, j, _) = g
    LwGen(a, b, c, d, e, f, h, i, j, k)
}

fn lwInfo() -> Lower[Info] {
    let! s = lwGet()
    pure(infoOf(s))
}

fn lwEnv() -> Lower[IntMap[ValType]] {
    let! s = lwGet()
    pure(gEnv(genOf(s)))
}

fn lwSetEnv(env: IntMap[ValType]) -> Lower[Unit] {
    lwModify(fn(s: LwState) -> LwState { setGen(s, gWithEnv(genOf(s), env)) })
}

fn lwSetCur(c: LwCur) -> Lower[Unit] {
    lwModify(fn(s: LwState) -> LwState { setCur(s, c) })
}

fn lwCurNow() -> Lower[LwCur] {
    let! s = lwGet()
    pure(curOf(s))
}

fn emptyCur() -> LwCur {
    let m: IntMap[Int] = imEmpty()
    LwCur(Nil, 0, m)
}

fn lwLocals() -> Lower[List[ValType]] {
    let! s = lwGet()
    let LwCur(ls, _, _) = curOf(s)
    pure(reverse(ls))
}

fn lwAlloc(vt: ValType) -> Lower[Int] {
    let! s = lwGet()
    let LwCur(ls, n, m) = curOf(s)
    let! _ = lwSetCur(LwCur(Cons(vt, ls), n + 1, m))
    pure(n)
}

fn lwBindSym(sid: Int, lid: Int) -> Lower[Unit] {
    let! s = lwGet()
    let LwCur(ls, n, m) = curOf(s)
    lwSetCur(LwCur(ls, n, imInsert(m, sid, lid)))
}

fn lwLocal(sid: Int) -> Lower[Int] {
    let! s = lwGet()
    let LwCur(_, _, m) = curOf(s)
    pure(withDefault(imLookup(m, sid), 0))
}

fn dummySym() -> Symbol {
    Symbol(CkSymLocal, "", TyUnit, Pos(0, 0), -1, None, Nil, -1)
}

fn symOf(info: Info, sid: Int) -> Symbol {
    withDefault(imLookup(infoSymbols(info), sid), dummySym())
}

fn exprTy(info: Info, e: Expr) -> Type {
    withDefault(imLookup(infoTypes(info), exprId(e)), TyUnit)
}

fn emptyTyEnv() -> TyEnv {
    let datas: IntMap[DataInfo] = imEmpty()
    let names: IntMap[String] = imEmpty()
    let sols: IntMap[Type] = imEmpty()
    TyEnv(datas, names, sols)
}

fn valTypeIn(env: IntMap[ValType], t: Type) -> ValType {
    match t {
        TyInt => VtInt,
        TyBool => VtBool,
        TyString => VtPtr,
        TyUnit => VtBool,
        TyFunc(_, _) => VtFuncRef,
        TyNamed(id, _) => if id == tyIOData() {
            VtFuncRef
        } else {
            VtPtr
        },
        TyParam(id, _) => withDefault(imLookup(env, id), VtInt),
        TyMeta(_) => VtInt,
    }
}

fn mapVals(env: IntMap[ValType], ts: List[Type], acc: List[ValType]) -> List[ValType] {
    match ts {
        Nil => reverse(acc),
        Cons(t, rest) => mapVals(env, rest, Cons(valTypeIn(env, t), acc)),
    }
}

fn sigIn(env: IntMap[ValType], t: Type) -> Sig {
    match t {
        TyFunc(ps, r) => IrSig(mapVals(env, ps, Nil), valTypeIn(env, r)),
        _ => IrSig(Nil, VtInt),
    }
}

fn bindEnv(tps: List[Type], reps: List[ValType], env: IntMap[ValType]) -> IntMap[ValType] {
    match tps {
        Nil => env,
        Cons(tp, trest) => match reps {
            Nil => env,
            Cons(r, rrest) => match tp {
                TyParam(id, _) => bindEnv(trest, rrest, imInsert(env, id, r)),
                _ => bindEnv(trest, rrest, env),
            },
        },
    }
}

fn repKey(reps: List[ValType]) -> String {
    match reps {
        Nil => "",
        Cons(v, rest) => match rest {
            Nil => irValName(v),
            _ => irValName(v) ++ "," ++ repKey(rest),
        },
    }
}

fn lwTypeVT(t: Type) -> Lower[ValType] {
    let! env = lwEnv()
    pure(valTypeIn(env, t))
}

fn lwExprVT(e: Expr) -> Lower[ValType] {
    let! info = lwInfo()
    lwTypeVT(exprTy(info, e))
}

fn lwIdVT(id: Int) -> Lower[ValType] {
    let! info = lwInfo()
    lwTypeVT(withDefault(imLookup(infoTypes(info), id), TyUnit))
}

fn lwSymVT(sid: Int) -> Lower[ValType] {
    let! info = lwInfo()
    let Symbol(_, _, typ, _, _, _, _, _) = symOf(info, sid)
    lwTypeVT(typ)
}

fn ctorTag(sym: Symbol) -> Int {
    let Symbol(_, _, _, _, _, ctor, _, _) = sym
    match ctor {
        None => 0,
        Some(p) => match p {
            Pair(_, tag) => tag,
        },
    }
}

fn listHas(xs: List[Int], x: Int) -> Bool {
    match xs {
        Nil => false,
        Cons(y, rest) => if y == x {
            true
        } else {
            listHas(rest, x)
        },
    }
}

fn localGets(ps: List[ValType], i: Int, acc: List[IrExpr]) -> List[IrExpr] {
    match ps {
        Nil => reverse(acc),
        Cons(t, rest) => localGets(rest, i + 1, Cons(IrLocalGet(i, t), acc)),
    }
}

fn atVT(xs: List[ValType], i: Int) -> ValType {
    match xs {
        Nil => VtInt,
        Cons(x, rest) => if i == 0 {
            x
        } else {
            atVT(rest, i - 1)
        },
    }
}

fn isIO(b: Int) -> Bool {
    b >= 6 && b <= 16 || b == 23
}

fn primOf(b: Int) -> PrimOp {
    if b == 0 {
        IrStrLength
    } else if b == 1 {
        IrStrByteAt
    } else if b == 2 {
        IrStrSlice
    } else if b == 3 {
        IrStrFromByte
    } else if b == 4 {
        IrStrCompare
    } else if b == 5 {
        IrIntToString
    } else if b == 17 {
        IrBitAnd
    } else if b == 18 {
        IrBitOr
    } else if b == 19 {
        IrBitXor
    } else if b == 20 {
        IrShiftLeft
    } else if b == 21 {
        IrShiftRight
    } else {
        IrShiftRightUnsigned
    }
}

fn ioBuiltinName(b: Int) -> String {
    if b == 6 {
        "pure"
    } else if b == 7 {
        "bind"
    } else if b == 8 {
        "print"
    } else if b == 9 {
        "eprint"
    } else if b == 10 {
        "read_stdin"
    } else if b == 11 {
        "read_file"
    } else if b == 12 {
        "file_exists"
    } else if b == 13 {
        "write_file"
    } else if b == 14 {
        "arg_count"
    } else if b == 15 {
        "arg_at"
    } else if b == 16 {
        "exit"
    } else {
        "read_stdin_chunk"
    }
}

fn ioActionName(b: Int, reps: List[ValType]) -> String {
    let base = "io." ++ ioBuiltinName(b)
    match reps {
        Nil => base,
        _ => base ++ "[" ++ repKey(reps) ++ "]",
    }
}

fn ioKey(b: Int, reps: List[ValType]) -> String {
    intToString(b) ++ ":" ++ repKey(reps)
}

fn ioResult(b: Int, reps: List[ValType]) -> ValType {
    if b == 6 {
        atVT(reps, 0)
    } else if b == 7 {
        atVT(reps, 1)
    } else if b == 14 {
        VtInt
    } else if b == 10 || b == 11 || b == 15 || b == 23 {
        VtPtr
    } else {
        VtBool
    }
}

fn ioLocals(b: Int, reps: List[ValType]) -> List[ValType] {
    if b == 7 {
        Cons(VtPtr, Cons(atVT(reps, 0), Nil))
    } else {
        Cons(VtPtr, Nil)
    }
}

fn ioField(index: Int, t: ValType) -> IrExpr {
    IrField(0, index, t)
}

fn ioBindBody(a: ValType, result: ValType) -> IrExpr {
    IrBlock(Cons(IrLet(1, IrCallIndirect(ioField(0, VtFuncRef), IrSig(Nil, a), Nil, false)), Nil), IrCallIndirect(IrCallIndirect(ioField(1, VtFuncRef), IrSig(Cons(a, Nil), VtFuncRef), Cons(IrLocalGet(1, a), Nil), false), IrSig(Nil, result), Nil, true))
}

fn ioBody(b: Int, reps: List[ValType]) -> IrExpr {
    if b == 6 {
        ioField(0, atVT(reps, 0))
    } else if b == 7 {
        ioBindBody(atVT(reps, 0), atVT(reps, 1))
    } else if b == 8 {
        IrPrim(IrIOPrint, Cons(ioField(0, VtPtr), Nil))
    } else if b == 9 {
        IrPrim(IrIOEPrint, Cons(ioField(0, VtPtr), Nil))
    } else if b == 10 {
        IrPrim(IrIOReadStdin, Nil)
    } else if b == 11 {
        IrPrim(IrIOReadFile, Cons(ioField(0, VtPtr), Nil))
    } else if b == 12 {
        IrPrim(IrIOFileExists, Cons(ioField(0, VtPtr), Nil))
    } else if b == 13 {
        IrPrim(IrIOWriteFile, Cons(ioField(0, VtPtr), Cons(ioField(1, VtPtr), Nil)))
    } else if b == 14 {
        IrPrim(IrIOArgCount, Nil)
    } else if b == 15 {
        IrPrim(IrIOArgAt, Cons(ioField(0, VtInt), Nil))
    } else if b == 16 {
        IrPrim(IrIOExit, Cons(ioField(0, VtInt), Nil))
    } else {
        IrPrim(IrIOReadStdinChunk, Cons(ioField(0, VtInt), Nil))
    }
}

fn enq(q: LwQ, inst: LwInst) -> LwQ {
    let LwQ(front, back) = q
    LwQ(front, Cons(inst, back))
}

fn deq(q: LwQ) -> Option[Pair[LwInst, LwQ]] {
    let LwQ(front, back) = q
    match front {
        Cons(x, rest) => Some(Pair(x, LwQ(rest, back))),
        Nil => match reverse(back) {
            Nil => None,
            Cons(x, rest) => Some(Pair(x, LwQ(rest, Nil))),
        },
    }
}

fn lwAddFunc(name: String, sig: Sig, locals: List[ValType], body: IrExpr) -> Lower[Int] {
    Lower(fn(s: LwState) -> LwResult[Int] {
        let LwMod(fs, n, table, main, cmd) = modOf(s)
        let s2 = setMod(s, LwMod(imInsert(fs, n, IrFunc(name, sig, locals, body)), n + 1, table, main, cmd))
        LwOk(n, s2)
    })
}

fn lwAddShell(name: String, sig: Sig) -> Lower[Int] {
    lwAddFunc(name, sig, Nil, IrBoolConst(false))
}

fn lwSetBody(id: Int, locals: List[ValType], body: IrExpr) -> Lower[Unit] {
    lwModify(fn(s: LwState) -> LwState {
        let LwMod(fs, n, table, main, cmd) = modOf(s)
        let IrFunc(name, sig, _, _) = withDefault(imLookup(fs, id), IrFunc("", IrSig(Nil, VtInt), Nil, IrBoolConst(false)))
        setMod(s, LwMod(imInsert(fs, id, IrFunc(name, sig, locals, body)), n, table, main, cmd))
    })
}

fn lwGetFunc(id: Int) -> Lower[IrFunc] {
    let! s = lwGet()
    let LwMod(fs, _, _, _, _) = modOf(s)
    pure(withDefault(imLookup(fs, id), IrFunc("", IrSig(Nil, VtInt), Nil, IrBoolConst(false))))
}

fn lwAddTable(id: Int) -> Lower[Unit] {
    let! s = lwGet()
    let LwMod(fs, n, table, main, cmd) = modOf(s)
    if listHas(table, id) {
        pure(())
    } else {
        lwModify(fn(s2: LwState) -> LwState {
            let LwMod(fs2, n2, table2, main2, cmd2) = modOf(s2)
            setMod(s2, LwMod(fs2, n2, append(table2, Cons(id, Nil)), main2, cmd2))
        })
    }
}

fn lwSetMainId(id: Int) -> Lower[Unit] {
    lwModify(fn(s: LwState) -> LwState {
        let LwMod(fs, n, table, _, cmd) = modOf(s)
        setMod(s, LwMod(fs, n, table, id, cmd))
    })
}

fn lwSetCommand(cmd: Bool) -> Lower[Unit] {
    lwModify(fn(s: LwState) -> LwState {
        let LwMod(fs, n, table, main, _) = modOf(s)
        setMod(s, LwMod(fs, n, table, main, cmd))
    })
}

fn lwLookupDecl(decl: Int) -> Lower[Option[Int]] {
    let! s = lwGet()
    pure(imLookup(gDecls(genOf(s)), decl))
}

fn lwSetDecl(decl: Int, id: Int) -> Lower[Unit] {
    lwModify(fn(s: LwState) -> LwState {
        let g = genOf(s)
        setGen(s, gWithDecls(g, imInsert(gDecls(g), decl, id)))
    })
}

fn lwLookupInst(key: String) -> Lower[Option[Int]] {
    let! s = lwGet()
    pure(smLookup(gInsts(genOf(s)), key))
}

fn lwSetInst(key: String, id: Int) -> Lower[Unit] {
    lwModify(fn(s: LwState) -> LwState {
        let g = genOf(s)
        setGen(s, gWithInsts(g, smInsert(gInsts(g), key, id)))
    })
}

fn lwLookupRef(id: Int) -> Lower[Option[Int]] {
    let! s = lwGet()
    pure(imLookup(gRefs(genOf(s)), id))
}

fn lwSetRef(id: Int, wid: Int) -> Lower[Unit] {
    lwModify(fn(s: LwState) -> LwState {
        let g = genOf(s)
        setGen(s, gWithRefs(g, imInsert(gRefs(g), id, wid)))
    })
}

fn lwLookupBRef(b: Int) -> Lower[Option[Int]] {
    let! s = lwGet()
    pure(imLookup(gBRefs(genOf(s)), b))
}

fn lwSetBRef(b: Int, id: Int) -> Lower[Unit] {
    lwModify(fn(s: LwState) -> LwState {
        let g = genOf(s)
        setGen(s, gWithBRefs(g, imInsert(gBRefs(g), b, id)))
    })
}

fn lwLookupIOAct(key: String) -> Lower[Option[Int]] {
    let! s = lwGet()
    pure(smLookup(gActs(genOf(s)), key))
}

fn lwSetIOAct(key: String, id: Int) -> Lower[Unit] {
    lwModify(fn(s: LwState) -> LwState {
        let g = genOf(s)
        setGen(s, gWithActs(g, smInsert(gActs(g), key, id)))
    })
}

fn lwLookupIORef(key: String) -> Lower[Option[Int]] {
    let! s = lwGet()
    pure(smLookup(gIORefs(genOf(s)), key))
}

fn lwSetIORef(key: String, id: Int) -> Lower[Unit] {
    lwModify(fn(s: LwState) -> LwState {
        let g = genOf(s)
        setGen(s, gWithIORefs(g, smInsert(gIORefs(g), key, id)))
    })
