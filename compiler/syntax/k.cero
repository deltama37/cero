import "std/list"
import "syntax/diag"
import "syntax/token"

// Ident / If / Match / Import は ast の構築子と名前が衝突する。
// ast と token を同時に import できないので、Kind を整数で渡す。

pub type Tok = | Tok(Int, String, Pos)

pub fn kindAsInt(k: Kind) -> Int {
    kindToInt(k)
}

pub fn intAsKind(n: Int) -> Kind {
    intToKind(n)
}

pub fn kDescribeKind(n: Int) -> String {
    kindString(intToKind(n))
}

pub fn unaryOpName(k: Kind) -> String {
    match k {
        Minus => "neg",
        Bang => "not",
        _ => "?",
    }
}

pub fn binaryOpName(k: Kind) -> String {
    match k {
        Plus => "+",
        PlusPlus => "++",
        Minus => "-",
        Star => "*",
        Slash => "/",
        Percent => "%",
        Eq => "==",
        NotEq => "!=",
        Lt => "<",
        LtEq => "<=",
        Gt => ">",
        GtEq => ">=",
        AndAnd => "&&",
        OrOr => "||",
        _ => "?",
    }
}

pub fn kEOF() -> Int {
    kindToInt(EOF)
}

pub fn kIdent() -> Int {
    kindToInt(Ident)
}

