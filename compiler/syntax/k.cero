fn toksAcc(ts: List[Token], acc: List[Tok]) -> List[Tok] {
    match ts {
        Nil => reverse(acc),
        Cons(t, rest) => match t {
            Token(k, text, pos) => toksAcc(rest, Cons(Tok(kindToInt(k), text, pos), acc)),
        },
    }
}

pub fn toksOf(ts: List[Token]) -> List[Tok] {
    toksAcc(ts, Nil)
}
