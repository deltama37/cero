import "std/io"
import "std/list"
import "std/string"
import "syntax/diag"
import "syntax/print"
import "driver/load"
import "check/program"
import "ir/print"
import "lower/lower"
import "wasm/encode"
import "fmt/fmt"

fn usage() -> String {
    "ceroc: usage: ceroc [--std DIR] parse|check|ir FILE | build FILE [-o OUT] | fmt [-w|--check] FILE...\n"
}

fn die(code: Int, msg: String) -> IO[Unit] {
    let! _ = eprint(msg)
    exit(code)
}

type Parsed =
    | Usage
    | Cmd(String, String, String, String)
    | FmtCmd(String, List[String])

fn splitStd(xs: List[String], stdDir: String, acc: List[String]) -> Parsed {
    match xs {
        Nil => parseCmd(stdDir, reverse(acc)),
        Cons(a, rest) => if a == "--std" {
            match rest {
                Nil => Usage,
                Cons(dir, rest2) => splitStd(rest2, dir, acc),
            }
        } else {
            splitStd(rest, stdDir, Cons(a, acc))
        },
    }
}

fn parseCheck(stdDir: String, xs: List[String]) -> Parsed {
    match xs {
        Cons(file, Nil) => Cmd(stdDir, "check", file, ""),
        Cons(flag, Cons(file, Nil)) => if flag == "--types" {
            Cmd(stdDir, "check", file, "--types")
        } else {
            Usage
        },
        _ => Usage,
    }
}

fn parseCmd(stdDir: String, xs: List[String]) -> Parsed {
    match xs {
        Cons(cmd, rest) => if cmd == "parse" || cmd == "ir" {
            match rest {
                Cons(file, Nil) => Cmd(stdDir, cmd, file, ""),
                _ => Usage,
            }
        } else if cmd == "check" {
            parseCheck(stdDir, rest)
        } else if cmd == "build" {
            parseBuild(stdDir, rest, "", "")
        } else if cmd == "fmt" {
            parseFmt(rest)
        } else {
            Usage
        },
        Nil => Usage,
    }
}

fn parseFmt(xs: List[String]) -> Parsed {
    match xs {
        Cons(flag, rest) => if flag == "-w" {
            parseFmtFiles(rest, "w", Nil)
        } else if flag == "--check" {
            parseFmtFiles(rest, "check", Nil)
        } else if stringLength(flag) > 0 && stringByteAt(flag, 0) == '-' {
            Usage
        } else {
            match rest {
                Nil => FmtCmd("", Cons(flag, Nil)),
                _ => Usage,
            }
        },
        Nil => Usage,
    }
}

fn parseFmtFiles(xs: List[String], mode: String, acc: List[String]) -> Parsed {
    match xs {
        Nil => if length(acc) == 0 {
            Usage
        } else {
            FmtCmd(mode, reverse(acc))
        },
        Cons(file, rest) => if stringLength(file) > 0 && stringByteAt(file, 0) == '-' {
            Usage
        } else {
            parseFmtFiles(rest, mode, Cons(file, acc))
        },
    }
}

fn parseBuild(stdDir: String, xs: List[String], file: String, out: String) -> Parsed {
    match xs {
        Nil => if file == "" { Usage } else { Cmd(stdDir, "build", file, out) },
        Cons(a, rest) => if a == "-o" {
            match rest {
                Nil => Usage,
                Cons(o, rest2) => parseBuild(stdDir, rest2, file, o),
            }
        } else if stringLength(a) > 0 && stringByteAt(a, 0) == '-' {
            Usage
        } else if file != "" {
            Usage
        } else {
            parseBuild(stdDir, rest, a, out)
        },
    }
}

fn writeMods(ms: List[Module]) -> IO[Unit] {
    match ms {
        Nil => pure(()),
        Cons(m, rest) => match m {
            Module(_, file, ast, _) => {
                let! _ = print("== " ++ file ++ "\n" ++ astFormatFile(ast) ++ "\n")
                writeMods(rest)
            },
        },
    }
}

fn runCheck(stdDir: String, file: String, flag: String) -> IO[Unit] {
    let! ok = fileExists(file)
    if ok {
        let! result = loadProgram(file, stdDir)
        match result {
            LoadFailed(e) => die(1, formatError(e) ++ "\n"),
            Loaded(mods, _) => match checkProgram(mods) {
                Err(e) => die(1, formatError(e) ++ "\n"),
                Ok(info) => if flag == "--types" {
                    print(ckFormatTypes(mods, info))
                } else {
                    pure(())
                },
            },
        }
    } else {
        die(1, "ceroc: cannot read " ++ file ++ "\n")
    }
}

fn runIr(stdDir: String, file: String) -> IO[Unit] {
    let! ok = fileExists(file)
    if ok {
        let! result = loadProgram(file, stdDir)
        match result {
            LoadFailed(e) => die(1, formatError(e) ++ "\n"),
            Loaded(mods, _) => match checkProgram(mods) {
                Err(e) => die(1, formatError(e) ++ "\n"),
                Ok(info) => print(irFormat(lowerProgram(mods, info)) ++ "\n"),
            },
        }
    } else {
        die(1, "ceroc: cannot read " ++ file ++ "\n")
    }
}

fn defaultOutput(input: String) -> String {
    if endsWith(input, ".cero") {
        stringSlice(input, 0, stringLength(input) - 5) ++ ".wasm"
    } else {
        input ++ ".wasm"
    }
}

fn runBuild(stdDir: String, file: String, out: String) -> IO[Unit] {
    let! ok = fileExists(file)
    if ok {
        let! result = loadProgram(file, stdDir)
        match result {
            LoadFailed(e) => die(1, formatError(e) ++ "\n"),
            Loaded(mods, _) => match checkProgram(mods) {
                Err(e) => die(1, formatError(e) ++ "\n"),
                Ok(info) => {
                    let wasm = encodeModule(lowerProgram(mods, info))
                    let dest = if out == "" { defaultOutput(file) } else { out }
                    if dest == "-" {
                        print(wasm)
                    } else {
                        writeFile(dest, wasm)
                    }
                },
            },
        }
    } else {
        die(1, "ceroc: cannot read " ++ file ++ "\n")
    }
}

fn fmtDie(code: Int, msg: String) -> IO[Bool] {
    let! _ = eprint(msg)
    let! _ = exit(code)
    pure(false)
}

fn fmtOne(file: String, mode: String) -> IO[Bool] {
    let! ok = fileExists(file)
    if ok {
        let! src = readFile(file)
        match fmFormat(src) {
            Err(e) => fmtDie(1, formatError(errorWithFile(e, file)) ++ "\n"),
            Ok(out) => if mode == "w" {
                if out == src {
                    pure(false)
                } else {
                    let! _ = writeFile(file, out)
                    pure(false)
                }
            } else if mode == "check" {
                if out == src {
                    pure(false)
                } else {
                    let! _ = print(file ++ "\n")
                    pure(true)
                }
            } else {
                let! _ = print(out)
                pure(false)
            },
        }
    } else {
        fmtDie(1, "ceroc: cannot read " ++ file ++ "\n")
    }
}

fn fmtAll(files: List[String], mode: String, bad: Bool) -> IO[Unit] {
    match files {
        Nil => if mode == "check" && bad {
            exit(1)
        } else {
            pure(())
        },
        Cons(file, rest) => {
            let! failed = fmtOne(file, mode)
            fmtAll(rest, mode, bad || failed)
        },
    }
}

fn dispatch(stdDir: String, cmd: String, file: String, flag: String) -> IO[Unit] {
    if cmd == "build" {
        runBuild(stdDir, file, flag)
    } else if cmd == "ir" {
        runIr(stdDir, file)
    } else if cmd == "check" {
        runCheck(stdDir, file, flag)
    } else {
        let! ok = fileExists(file)
        if ok {
            let! result = loadProgram(file, stdDir)
            match result {
                LoadFailed(e) => die(1, formatError(e) ++ "\n"),
                Loaded(mods, _) => writeMods(mods),
            }
        } else {
            die(1, "ceroc: cannot read " ++ file ++ "\n")
        }
    }
}

fn main() -> IO[Unit] {
    let! argv = args()
    match splitStd(argv, "std", Nil) {
        Usage => die(2, usage()),
        Cmd(stdDir, cmd, file, flag) => dispatch(stdDir, cmd, file, flag),
        FmtCmd(mode, files) => fmtAll(files, mode, false),
    }
}
