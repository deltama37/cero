import "std/list"
fn main() -> Int {
    let xs = range(0, 1000000)
    let ys = filter(map(xs, fn(x: Int) -> Int { x + 1 }), fn(x: Int) -> Bool { x > 0 })
    if length(ys) == 1000000 && foldr(xs, 0, fn(x: Int, acc: Int) -> Int { acc + 1 }) == 1000000 && length(xs) == 1000000 {
        1
    } else {
        0
    }
}
