type List[T] =
    | Nil
    | Cons(T, List[T])

fn range(from: Int, to: Int) -> List[Int] {
    if from > to { Nil } else { Cons(from, range(from + 1, to)) }
}

fn foldl[T, A](xs: List[T], acc: A, f: (A, T) -> A) -> A {
    match xs {
        Nil => acc,
        Cons(x, rest) => foldl(rest, f(acc, x), f),
    }
}

fn main() -> Int {
    foldl(range(1, 10000), 0, fn(a: Int, x: Int) -> Int { a + x })
}
