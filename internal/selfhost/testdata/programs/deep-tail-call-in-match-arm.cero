type IntList =
    | Nil
    | Cons(Int, IntList)

fn build(n: Int, acc: IntList) -> IntList {
    if n == 0 {
        acc
    } else {
        build(n - 1, Cons(n, acc))
    }
}

fn sum(xs: IntList, acc: Int) -> Int {
    match xs {
        Nil => acc,
        Cons(x, rest) => sum(rest, acc + x),
    }
}

fn main() -> Int {
    sum(build(1000000, Nil), 0)
}
